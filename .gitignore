.venv-docker/
docker_tmp/
tmp/

# Native build artifacts
*.mod

# Runtime native binaries are required locally but not tracked in normal Git history.
bin/linux-x86_64/*.x

# Project runtime outputs
project/cases/*/run/
project/cases/*/runs/
project/cases/*/deliverables/
project/cases/*/logs/
project/cases/*/tmp/
project/current
project/cases/smoke5d_docker_test/

# Large or downloaded meteorological raw data
project/cases/*/met/**/raw/
project/cases/*/met/**/isd_raw/
project/cases/*/met/**/download/
project/cases/*/met/**/downloads/
project/cases/*/met/
project/cases/*/geo/

# Common model outputs
*.lst
*.con
*.grd
*.dat
*.out
*.plt
*.bin

# Keep placeholders
!bin/linux-x86_64/.gitkeep
!bin/linux-arm64/.gitkeep
!bin/windows-x86_64/.gitkeep

# Local git history backups created during reset
.git.backup_*/

# Keep minimal smoke case metadata
!project/cases/smoke5d/
project/cases/smoke5d/*
!project/cases/smoke5d/case.yaml
!project/cases/smoke5d/grid/
!project/cases/smoke5d/grid/center_location
!project/cases/smoke5d/grid/grid.cmn
!project/cases/smoke5d/grid/research_time

